{
  "memsearch": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash ./hooks/session-start.sh",
        "timeout": 30
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash ./hooks/pre-invocation.sh",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bash ./hooks/stop.sh",
        "timeout": 15
      }
    ]
  }
}
